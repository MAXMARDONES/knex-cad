C RS4OP D1 1,1.5,7.5 z -y
H RS4OK W8 1,1,7.5
P 1,0.85,7.5 blue
P 1,1.15,7.5 blue
R RS4 RS4O
R RS4O RS4OP
! relay RS5 rides the shoulder axis
H RS5 W8 1,-1.5,6.5 -x-z
C RS5I W8 0,-1.5,5.5 -x+z -y
C RS5IP D1 0,-2.5,5.5 z y
H RS5IK W8 0,-2,5.5
P 0,-2.15,5.5 blue
P 0,-1.85,5.5 blue
